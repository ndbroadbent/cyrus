{
  "description": "filter_tensor_indices utility function tests",
  "test_cases": [
    {
      "name": "cytools_docstring_example",
      "input_tensor": [
        {"indices": [0, 1], "value": 0},
        {"indices": [1, 1], "value": 1},
        {"indices": [1, 2], "value": 2},
        {"indices": [1, 3], "value": 3},
        {"indices": [2, 3], "value": 4}
      ],
      "indices": [1, 3],
      "expected": [
        {"indices": [0, 0], "value": 1},
        {"indices": [0, 1], "value": 3}
      ]
    },
    {
      "name": "rank3_tensor",
      "input_tensor": [
        {"indices": [0, 0, 0], "value": 1},
        {"indices": [0, 0, 1], "value": 2},
        {"indices": [0, 1, 1], "value": 3},
        {"indices": [1, 1, 1], "value": 4},
        {"indices": [0, 1, 2], "value": 5},
        {"indices": [0, 2, 2], "value": 6}
      ],
      "indices": [0, 2],
      "expected": [
        {"indices": [0, 0, 0], "value": 1},
        {"indices": [0, 1, 1], "value": 6}
      ]
    },
    {
      "name": "intersection_basis_transform",
      "comment": "Simulates what happens with intersection_numbers(in_basis=True)",
      "input_tensor": [
        {"indices": [5, 5, 5], "value": -1},
        {"indices": [5, 7, 8], "value": 1},
        {"indices": [5, 8, 8], "value": -2},
        {"indices": [6, 7, 8], "value": 1},
        {"indices": [6, 8, 8], "value": -2},
        {"indices": [7, 8, 8], "value": -2},
        {"indices": [8, 8, 8], "value": 8}
      ],
      "indices": [5, 6, 7, 8],
      "expected": [
        {"indices": [0, 0, 0], "value": -1},
        {"indices": [0, 2, 3], "value": 1},
        {"indices": [0, 3, 3], "value": -2},
        {"indices": [1, 2, 3], "value": 1},
        {"indices": [1, 3, 3], "value": -2},
        {"indices": [2, 3, 3], "value": -2},
        {"indices": [3, 3, 3], "value": 8}
      ]
    }
  ]
}
